{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zeus/config",
  "title": "Zeus Config",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "description": "项目名称" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "north_star": {
          "type": "string",
          "description": "唯一优化目标，如 conversion / revenue / pv_uv"
        }
      }
    },
    "subagent": {
      "type": "object",
      "properties": {
        "dispatcher": {
          "type": "string",
          "enum": ["auto", "kimi", "claude", "mock", "human", "docker"],
          "default": "auto",
          "description": "子 Agent 调度方式 (auto/kimi/claude/mock/human/docker)"
        }
      }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["copytree", "bind_mount"],
          "default": "copytree",
          "description": "工作空间创建方式"
        }
      }
    }
  }
}
